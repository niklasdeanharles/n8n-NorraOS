        [
          {
            "node": "Per Campaign",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  },
  "norra": {
    "slug": "outbound-call",
    "crossTenant": {
      "Load Running Campaigns": "Ein Zeitplan hat keine Organisation. Dieser Node holt die laufenden Kampagnen aller Mandanten; jede weitere Abfrage im Lauf filtert wieder nach der organization_id der jeweiligen Kampagne."
    }
  }
}
