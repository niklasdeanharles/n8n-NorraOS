{
  "name": "Norra – Tool: lookup_record",
  "nodes": [
    {
      "name": "Lookup Requested",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "organization_id",
              "type": "string"
            },
            {
              "name": "conversation_id",
              "type": "string"
            },
            {
              "name": "agent_id",
              "type": "string"
            },
            {
              "name": "endpoint",
              "type": "string"
            },
            {
              "name": "query",
              "type": "string"
            },
            {
              "name": "record_type",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Call Configured Endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.endpoint }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.query }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "name": "Log Tool Call",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "tool_calls_log",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "organization_id",
              "fieldValue": "={{ $('Lookup Requested').item.json.organization_id }}"
            },
            {
              "fieldId": "conversation_id",
              "fieldValue": "={{ $('Lookup Requested').item.json.conversation_id }}"
            },
            {
              "fieldId": "agent_id",
              "fieldValue": "={{ $('Lookup Requested').item.json.agent_id }}"
            },
            {
              "fieldId": "tool_name",
              "fieldValue": "lookup_record"
            },
            {
              "fieldId": "n8n_workflow_id",
              "fieldValue": "={{ $workflow.id }}"
            },
            {
              "fieldId": "n8n_execution_id",
              "fieldValue": "={{ $execution.id }}"
            },
            {
              "fieldId": "input",
              "fieldValue": "={{ JSON.stringify($('Lookup Requested').item.json) }}"
            },
            {
              "fieldId": "output",
              "fieldValue": "={{ JSON.stringify($('Call Configured Endpoint').item.json).slice(0, 4000) }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "={{ $('Call Configured Endpoint').item.json.error ? 'error' : 'success' }}"
            }
          ]
        }
      }
    },
    {
      "name": "Return To Agent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "found",
              "name": "found",
              "value": "={{ !$('Call Configured Endpoint').item.json.error && Object.keys($('Call Configured Endpoint').item.json ?? {}).length > 0 }}",
              "type": "boolean"
            },
            {
              "id": "record",
              "name": "record",
              "value": "={{ $('Call Configured Endpoint').item.json }}",
              "type": "object"
            },
            {
              "id": "result",
              "name": "result",
              "value": "={{ $('Call Configured Endpoint').item.json.error ? 'Der Datensatz konnte nicht abgerufen werden. Sage das offen und biete die Uebergabe an einen Menschen an.' : JSON.stringify($('Call Configured Endpoint').item.json).slice(0, 2000) }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Sticky Note lookup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -50,
        -50
      ],
      "parameters": {
        "content": "## lookup_record – ein Tool, kein Konnektor\nDer Endpunkt kommt pro Turn aus der tools-Konfiguration des Agenten, nicht aus diesem Workflow. Damit dient derselbe Workflow jedem Kunden und jedem System: CRM, Auftragsverwaltung, Ticketsystem.\n\nneverError ist gesetzt, damit eine 404 als Datensatz zurueckkommt statt den Agenten-Turn abzubrechen -- der Agent soll \"nicht gefunden\" sagen koennen, nicht abstuerzen.\n\nReihenfolge ist Absicht: Return To Agent steht zuletzt, weil ein Sub-Workflow die Ausgabe seines letzten Nodes zurueckgibt.",
        "color": 4,
        "width": 740,
        "height": 260
      }
    }
  ],
  "connections": {
    "Lookup Requested": {
      "main": [
        [
          {
            "node": "Call Configured Endpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Configured Endpoint": {
      "main": [
        [
          {
            "node": "Log Tool Call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Tool Call": {
      "main": [
        [
          {
            "node": "Return To Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  },
  "norra": {
    "workflowId": "KHHKDV5CoyiDxuCO",
    "slug": "tool-lookup-record"
  },
  "tags": [
    "norra",
    "norra:tool"
  ]
}
