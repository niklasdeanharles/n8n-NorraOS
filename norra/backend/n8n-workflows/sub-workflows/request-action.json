    {
      "name": "File Ticket",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "tickets",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "organization_id",
              "fieldValue": "={{ $json.organization_id }}"
            },
            {
              "fieldId": "conversation_id",
              "fieldValue": "={{ $json.conversation_id }}"
            },
            {
              "fieldId": "agent_id",
              "fieldValue": "={{ $json.agent_id }}"
            },
            {
              "fieldId": "subject",
              "fieldValue": "={{ $json.subject }}"
            },
            {
              "fieldId": "description",
              "fieldValue": "={{ $json.reason }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "open"
            },
            {
              "fieldId": "priority",
              "fieldValue": "high"
            },
            {
              "fieldId": "source",
              "fieldValue": "agent_escalation"
            },
            {
              "fieldId": "external_ref",
              "fieldValue": "={{ JSON.stringify({ kind: $json.action, record_reference: $json.record_reference, amount: $json.amount, currency: $json.currency }) }}"
            }
          ]
        }
      }
    },
    {
      "name": "Mark Conversation Pending",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "conversations",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Action Requested').item.json.conversation_id }}"
            },
            {
              "keyName": "organization_id",
              "condition": "eq",
              "keyValue": "={{ $('Action Requested').item.json.organization_id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "pending"
            }
          ]
        }
      }
    },
    {
      "name": "Log Tool Call",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "tool_calls_log",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "organization_id",
              "fieldValue": "={{ $('Action Requested').item.json.organization_id }}"
            },
            {
              "fieldId": "conversation_id",
              "fieldValue": "={{ $('Action Requested').item.json.conversation_id }}"
            },
            {
              "fieldId": "agent_id",
              "fieldValue": "={{ $('Action Requested').item.json.agent_id }}"
            },
            {
              "fieldId": "tool_name",
              "fieldValue": "request_action"
            },
            {
              "fieldId": "n8n_workflow_id",
              "fieldValue": "={{ $workflow.id }}"
            },
            {
              "fieldId": "n8n_execution_id",
              "fieldValue": "={{ $execution.id }}"
            },
            {
              "fieldId": "input",
              "fieldValue": "={{ JSON.stringify($('Action Requested').item.json) }}"
            },
            {
              "fieldId": "output",
              "fieldValue": "={{ JSON.stringify({ ticket_number: $('File Ticket').item.json.number, approval_id: $('File Approval Request').item.json.id, executed: false }) }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "success"
            }
          ]
        }
      }
    },
    {
      "name": "Return To Agent",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "executed",
              "name": "executed",
              "value": "={{ false }}",
              "type": "boolean"
            },
            {
              "id": "approval-id",
              "name": "approval_id",
              "value": "={{ $('File Approval Request').item.json.id }}",
              "type": "string"
            },
            {
              "id": "ticket-number",
              "name": "ticket_number",
              "value": "={{ $('File Ticket').item.json.number }}",
              "type": "string"
            },
            {
              "id": "result",
              "name": "result",
              "value": "=Die Aktion wurde NICHT ausgefuehrt. Sie liegt als Ticket #{{ $('File Ticket').item.json.number }} zur Freigabe bei einem Mitarbeiter. Sage dem Kunden zu, dass ein Mitarbeiter prueft und sich meldet. Bestaetige niemals, dass die Aktion bereits erfolgt ist, und nenne keinen Termin.",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Sticky Note refund",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -50,
        -50
      ],
      "parameters": {
        "content": "## request_action fuehrt bewusst NICHTS aus\nJede folgenreiche Aktion -- Erstattung, Stornierung, Datenaenderung -- wird hier zur menschlichen Freigabe eingereicht, statt ausgefuehrt. Ein Sprachmodell, das eine Referenz und einen Betrag halluziniert, wuerde sonst echten Schaden anrichten, der nicht rueckholbar ist.\n\nDie Sperre ist die Zeile in approvals, nicht das Ticket: ein Ticket ist eine Notiz, die jemand uebersehen kann, eine Freigabe bleibt offen, bis ein Admin entscheidet.\n\nDer Rueckgabewert sagt dem Agenten ausdruecklich, dass nichts ausgefuehrt wurde.",
        "color": 3,
        "width": 740,
        "height": 340
      }
    },
    {
      "name": "File Approval Request",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "notes": "Die eigentliche Sperre: der Vorgang wartet als Zeile in approvals auf eine menschliche Entscheidung. Das Ticket allein waere nur eine Notiz, die jemand uebersehen kann.",
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "approvals",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "organization_id",
              "fieldValue": "={{ $('Action Requested').item.json.organization_id }}"
            },
            {
              "fieldId": "conversation_id",
              "fieldValue": "={{ $('Action Requested').item.json.conversation_id }}"
            },
            {
              "fieldId": "agent_id",
              "fieldValue": "={{ $('Action Requested').item.json.agent_id }}"
            },
            {
              "fieldId": "ticket_id",
              "fieldValue": "={{ $('File Ticket').item.json.id }}"
            },
            {
              "fieldId": "tool_name",
              "fieldValue": "={{ $('Action Requested').item.json.action }}"
            },
            {
              "fieldId": "summary",
              "fieldValue": "={{ $('Action Requested').item.json.subject }}"
            },
            {
              "fieldId": "amount",
              "fieldValue": "={{ $('Action Requested').item.json.amount || null }}"
            },
            {
              "fieldId": "currency",
              "fieldValue": "={{ $('Action Requested').item.json.currency || null }}"
            },
            {
              "fieldId": "payload",
              "fieldValue": "={{ JSON.stringify({ action: $('Action Requested').item.json.action, record_reference: $('Action Requested').item.json.record_reference, reason: $('Action Requested').item.json.reason, ticket_number: $('File Ticket').item.json.number }) }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "pending"
            }
          ]
        }
      }
    }
