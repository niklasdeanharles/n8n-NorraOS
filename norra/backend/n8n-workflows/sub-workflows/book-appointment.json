{
  "name": "Norra – Tool: book_appointment",
  "nodes": [
    {
      "id": "booking-requested",
      "name": "Booking Requested",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "organization_id",
              "type": "string"
            },
            {
              "name": "conversation_id",
              "type": "string"
            },
            {
              "name": "agent_id",
              "type": "string"
            },
            {
              "name": "call_id",
              "type": "string"
            },
            {
              "name": "requested_start",
              "type": "string"
            },
            {
              "name": "reason",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "load-agent-config",
      "name": "Load Agent Config",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "agents",
        "returnAll": false,
        "limit": 1,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Booking Requested').item.json.agent_id }}"
            },
            {
              "keyName": "organization_id",
              "condition": "eq",
              "keyValue": "={{ $('Booking Requested').item.json.organization_id }}"
            }
          ]
        }
      }
    },
    {
      "id": "resolve-slot",
      "name": "Resolve Slot",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "calendar",
              "name": "calendar_id",
              "type": "string",
              "value": "={{ ( ($('Load Agent Config').item.json.tools ?? []).find(tool => tool.slug === 'book_appointment')?.config ?? {}).calendar_id ?? \"\" }}"
            },
            {
              "id": "duration",
              "name": "duration_minutes",
              "type": "number",
              "value": "={{ Number(( ($('Load Agent Config').item.json.tools ?? []).find(tool => tool.slug === 'book_appointment')?.config ?? {}).duration_minutes) || 30 }}"
            },
            {
              "id": "start",
              "name": "start",
              "type": "string",
              "value": "={{ (() => { const raw = ($('Booking Requested').item.json.requested_start ?? \"\").trim(); if (!raw) return \"\"; const parsed = DateTime.fromISO(raw, { setZone: true }); return parsed.isValid ? parsed.toISO() : \"\"; })() }}"
            }
          ]
        }
      }
    },
    {
      "id": "slot-usable",
      "name": "Slot Usable?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.calendar_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            },
            {
              "leftValue": "={{ $json.start }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true
      }
    },
    {
      "id": "compute-end",
      "name": "Compute End",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "end",
              "name": "end",
              "type": "string",
              "value": "={{ (() => { const start = $('Resolve Slot').item.json.start; if (!start) return \"\"; const minutes = Number($('Resolve Slot').item.json.duration_minutes) || 30; return DateTime.fromISO(start, { setZone: true }).plus({ minutes }).toISO(); })() }}"
            }
          ]
        }
      }
    },
    {
      "id": "check-availability",
      "name": "Check Availability",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        1100,
        -100
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "calendar",
        "operation": "availability",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Resolve Slot').item.json.calendar_id }}"
        },
        "timeMin": "={{ $('Resolve Slot').item.json.start }}",
        "timeMax": "={{ $json.end }}",
        "options": {
          "outputFormat": "availability"
        }
      }
    },
    {
      "id": "is-free",
      "name": "Is Free?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.available }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true
      }
    },
    {
      "id": "create-event",
      "name": "Create Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        1540,
        -200
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Resolve Slot').item.json.calendar_id }}"
        },
        "start": "={{ $('Resolve Slot').item.json.start }}",
        "end": "={{ $('Compute End').item.json.end }}",
        "useDefaultReminders": true,
        "additionalFields": {
          "summary": "=Termin: {{ $('Booking Requested').item.json.reason || \"Rückruf\" }}",
          "description": "=Vereinbart im Telefonat mit Norra.\\n\\nAnliegen: {{ $('Booking Requested').item.json.reason || \"nicht genannt\" }}\\nAnrufer: {{ $('Load Call').item.json.from_e164 || \"unbekannt\" }}\\nKonversation: {{ $('Booking Requested').item.json.conversation_id }}",
          "showMeAs": "opaque"
        }
      }
    },
    {
      "id": "load-call",
      "name": "Load Call",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        880,
        40
      ],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "calls",
        "returnAll": false,
        "limit": 1,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Booking Requested').item.json.call_id }}"
            },
            {
              "keyName": "organization_id",
              "condition": "eq",
              "keyValue": "={{ $('Booking Requested').item.json.organization_id }}"
            }
          ]
        }
      }
    },
    {
      "id": "log-booked",
      "name": "Log Booked",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1760,
        -200
      ],
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "tool_calls_log",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "organization_id",
              "fieldValue": "={{ $('Booking Requested').item.json.organization_id }}"
            },
            {
              "fieldId": "conversation_id",
              "fieldValue": "={{ $('Booking Requested').item.json.conversation_id }}"
            },
            {
              "fieldId": "agent_id",
              "fieldValue": "={{ $('Booking Requested').item.json.agent_id }}"
            },
            {
              "fieldId": "tool_name",
              "fieldValue": "book_appointment"
            },
            {
              "fieldId": "n8n_workflow_id",
              "fieldValue": "={{ $workflow.id }}"
            },
            {
              "fieldId": "n8n_execution_id",
              "fieldValue": "={{ $execution.id }}"
            },
            {
              "fieldId": "input",
              "fieldValue": "={{ JSON.stringify($('Booking Requested').item.json) }}"
            },
            {
              "fieldId": "output",
              "fieldValue": "={{ JSON.stringify({ event_id: $('Create Event').item.json.id ?? null, start: $('Resolve Slot').item.json.start }) }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "={{ $('Create Event').item.json.id ? 'success' : 'error' }}"
            },
            {
              "fieldId": "error",
              "fieldValue": "={{ $('Create Event').item.json.id ? null : 'Kalender hat den Termin nicht angelegt' }}"
            }
          ]
        }
      }
    },
    {
      "id": "log-busy",
      "name": "Log Busy",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "tool_calls_log",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "organization_id",
              "fieldValue": "={{ $('Booking Requested').item.json.organization_id }}"
            },
            {
              "fieldId": "conversation_id",
              "fieldValue": "={{ $('Booking Requested').item.json.conversation_id }}"
            },
            {
              "fieldId": "agent_id",
              "fieldValue": "={{ $('Booking Requested').item.json.agent_id }}"
            },
            {
              "fieldId": "tool_name",
              "fieldValue": "book_appointment"
            },
