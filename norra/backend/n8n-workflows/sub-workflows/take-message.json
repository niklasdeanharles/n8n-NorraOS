              "type": "string",
              "value": "={{ (() => { if (!$('Normalize Request').item.json.body) return 'Frag den Anrufer, was genau ausgerichtet werden soll, und rufe das Tool danach erneut.'; if ($('Match Person').item.json.match.ambiguous) return 'Mehrere Personen passen auf den Namen. Frag nach dem Vornamen oder der Durchwahl.'; if (($('Match Person').item.json.match.candidates ?? []).length === 0) return 'Es ist niemand hinterlegt, der Nachrichten annimmt. Biete stattdessen einen Rueckruf an.'; return 'Diesen Namen gibt es hier nicht. Nenne die hinterlegten Namen und frag nach: ' + ($('Match Person').item.json.match.candidates ?? []).join(', '); })() }}"
            }
