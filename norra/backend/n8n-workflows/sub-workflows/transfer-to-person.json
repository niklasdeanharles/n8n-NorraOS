    {
      "id": "match-person",
      "name": "Match Person",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "match",
              "name": "match",
              "type": "object",
              "value": "={{ (() => { const people = ($('Collect Directory').item.json.data ?? [])  .filter(p => p.active && p.accepts_transfers); const said = String($('Normalize Request').item.json.person ?? '').toLowerCase().trim(); const names = people.map(p => p.name); if (!said || people.length === 0) return { found: false, ambiguous: false, candidates: names }; const bare = said.replace(/\\b(herr|herrn|frau|die|der|den|zu|mit|an|von)\\b/g, ' ')  .replace(/\\s+/g, ' ').trim(); const norm = (value) => String(value ?? \"\").toLowerCase().trim(); const digits = said.replace(/[^0-9]/g, \"\"); const exact = people.filter(p => norm(p.name) === bare); const byExtension = digits ? people.filter(p => norm(p.extension) === digits) : []; const bySurname = people.filter(p => {  const parts = norm(p.name).split(\" \").filter(Boolean);  const surname = parts[parts.length - 1];  return surname && (bare === surname || bare.split(\" \").includes(surname)); }); const contains = bare.length >= 3 ? people.filter(p => norm(p.name).includes(bare)) : []; const stages = [exact, byExtension, bySurname, contains]; const hit = stages.find(list => list.length === 1); if (!hit) return { found: false, ambiguous: stages.some(l => l.length > 1), candidates: names }; return { found: true, ambiguous: false, candidates: names, person: hit[0] }; })() }}"
            }
          ]
        }
      }
    },
