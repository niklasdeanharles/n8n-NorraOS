              "value": "={{ (() => { if ($('Match Person').item.json.match.ambiguous) return 'Mehrere Personen passen auf den Namen. Frag nach dem Vornamen oder der Durchwahl.'; if (($('Match Person').item.json.match.candidates ?? []).length === 0) return 'Es nimmt gerade niemand Anrufe entgegen. Biete an, eine Nachricht aufzunehmen.'; return 'Diese Person nimmt keine Anrufe entgegen oder es gibt sie hier nicht. Erreichbar sind: ' + ($('Match Person').item.json.match.candidates ?? []).join(', ') + '. Biete sonst an, eine Nachricht aufzunehmen.'; })() }}"
            }
