    {
      "name": "Shape Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Was das Modell zurueckgibt, auf eine Abschrift eindampfen.\n//\n// Die Form der Antwort haengt an Node-Version und `simplify`; statt eine davon\n// zu raten, werden die bekannten Stellen der Reihe nach gelesen. Kommt nichts\n// Brauchbares heraus, ist das kein Grund zum Abbruch -- die Aufnahme selbst\n// liegt weiter im Ticket, und ein Mensch kann sie anhoeren.\nconst asked = $('Normalize Request').first().json;\nconst payload = $input.first()?.json ?? {};\n\nconst candidate =\n  payload.text ??\n  payload.content ??\n  payload.output ??\n  payload.candidates?.[0]?.content?.parts?.[0]?.text ??\n  '';\n\nlet transcript = String(typeof candidate === 'string' ? candidate : '').trim();\n\n// Die Obergrenze spiegelt den Check-Constraint auf `calls.voicemail_transcript`.\n// Sie faengt nicht den redseligen Anrufer -- `Record` laeuft 180 Sekunden --,\n// sondern ein Modell, das statt einer Abschrift seitenweise Entschuldigungen\n// zurueckgibt. Abschneiden statt Abweisen: die ersten 20.000 Zeichen sind\n// immer noch die Nachricht.\nif (transcript.length > 20000) transcript = transcript.slice(0, 20000);\n\n// Bewusst *keine* Erkennung von Absagen des Modells (\"Es tut mir leid, ich\n// konnte nichts verstehen\"). Ein Muster dafuer trifft unweigerlich auch echte\n// Nachrichten: \"Leider muss ich den Termin absagen\" ist genau der Anruf, den\n// niemand verlieren darf. Eine Absage als Abschrift anzuzeigen ist harmlos --\n// der Link zur Aufnahme steht direkt darunter. Eine echte Nachricht\n// wegzuwerfen ist es nicht.\nconst ok = transcript.length > 0;\nconst url = String(asked.recording_url ?? '');\n\nreturn [{\n  json: {\n    ok,\n    transcript: ok ? transcript : null,\n    chars: ok ? transcript.length : 0,\n    description: ok\n      ? 'Abschrift der Sprachnachricht:\\n\\n' + transcript + (url ? '\\n\\nAufnahme: ' + url : '')\n      : 'Die Aufnahme konnte nicht automatisch verschriftet werden -- bitte anhoeren.'\n        + (url ? '\\n\\nAufnahme: ' + url : ''),\n  },\n}];"
      }
    },
