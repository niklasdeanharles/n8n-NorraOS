# Nach norra.env kopieren und ausfuellen. norra.env ist gitignored.
# Dieselben Namen wie in frontend/.env.example -- eine Liste, zwei Orte waere
# eine Liste, die irgendwann auseinanderlaeuft.

NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# Die oeffentliche n8n-URL funktioniert immer und ist die sichere Vorgabe.
# Haengen App und n8n im selben Docker-Netzwerk (siehe docker-compose.yml),
# ist `http://n8n:5678` schneller: der Aufruf bleibt im Rechner und braucht
# keinen TLS-Handshake pro Turn.
N8N_WEBHOOK_URL=https://deine-n8n-instanz
N8N_WEBHOOK_SECRET=

# Die oeffentliche Adresse dieser App. Twilio hasht die vollstaendige URL,
# also muss sie exakt dem entsprechen, was dort eingetragen ist.
NORRA_PUBLIC_URL=https://norra.deine-domain.de

TWILIO_AUTH_TOKEN=

# Betriebs-Screen: nur alle drei zusammen oeffnen die Karte "Die Instanz".
N8N_BASE_URL=https://deine-n8n-instanz
N8N_API_KEY=
NORRA_OPS_ORG_ID=
