# Copy to .env.local. Never commit real values.

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses RLS -- never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n instance on the Hostinger VPS
N8N_WEBHOOK_URL=https://n8n.example.com
# Shared with the n8n webhook's Header Auth credential
N8N_WEBHOOK_SECRET=generate-a-long-random-string

# Telephony (optional -- only needed for the phone assistant)
# Twilio Console -> Account Info -> Auth Token
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# The public base URL Twilio is pointed at. Signature validation hashes the full
# URL, so this must match what you pasted into Twilio, scheme included.
NORRA_PUBLIC_URL=https://your-app.netlify.app

# Optional. Wie lange ein Anruf-Turn auf den Agenten warten darf, in
# Millisekunden (2000-20000, Vorgabe 12000). Nur setzen, wenn der Gastgeber ein
# niedrigeres Limit hat als der Telefonanbieter: Netlifys Gratis-Tarif bricht
# Funktionen nach 10s ab, und ein Budget darueber heisst, dass unser eigener
# Abbruch nie greift -- der Anrufer bekaeme eine tote Leitung statt eines
# Satzes. Auf einem eigenen Server bleibt die Vorgabe.
# NORRA_VOICE_TIMEOUT_MS=8000

# Web widget token signing key derives from N8N_WEBHOOK_SECRET above -- no
# separate secret to configure. NORRA_PUBLIC_URL (set above, for telephony)
# also drives the embed snippet shown in each agent's console page.

# Betriebs-Screen (optional -- nur fuer den Betreiber der n8n-Instanz).
# Alle drei zusammen, sonst zeigt die Karte "Die Instanz" nichts:
#   N8N_BASE_URL     die n8n-URL fuer die Admin-API; fehlt sie, gilt N8N_WEBHOOK_URL
#   N8N_API_KEY      n8n -> Settings -> API. Nur lesend genutzt.
#   NORRA_OPS_ORG_ID die Organisation des Betreibers. Ohne sie sieht niemand die
#                    Instanz -- sie gehoert allen Mandanten gemeinsam, und ein
#                    API-Key allein waere die Abkuerzung, die das aufhebt.
N8N_BASE_URL=https://n8n.example.com
N8N_API_KEY=
NORRA_OPS_ORG_ID=
