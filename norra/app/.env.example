# Copy to .env.local. Never commit real values.

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses RLS -- never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n instance on the Hostinger VPS
N8N_WEBHOOK_URL=https://n8n.example.com
# Shared with the n8n webhook's Header Auth credential
N8N_WEBHOOK_SECRET=generate-a-long-random-string
