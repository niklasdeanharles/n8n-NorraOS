            },
            {
              "fieldId": "agent_id",
              "fieldValue": "={{ $json.agent_id }}"
            },
            {
              "fieldId": "subject",
              "fieldValue": "=Rueckerstattung angefragt: {{ $json.order_reference }} ueber {{ $json.amount }} {{ $json.currency }}"
