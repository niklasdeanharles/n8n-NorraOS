              "fieldValue": "high"
            },
            {
              "fieldId": "source",
              "fieldValue": "agent_escalation"
            },
            {
              "fieldId": "external_ref",
              "fieldValue": "={{ JSON.stringify({ kind: \"refund_request\", order_reference: $json.order_reference, amount: $json.amount, currency: $json.currency }) }}"
            }
          ]
        }
      }
    },
    {
