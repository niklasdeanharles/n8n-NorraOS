              "type": "string"
            },
            {
              "id": "result",
              "name": "result",
              "value": "=Die Rueckerstattung wurde NICHT ausgefuehrt. Sie liegt als Ticket #{{ $('File Refund Request').item.json.number }} zur Freigabe bei einem Mitarbeiter. Sage dem Kunden zu, dass die Erstattung geprueft wird und er Bescheid bekommt. Bestaetige keine erfolgte Erstattung und nenne keinen Auszahlungstermin.",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Sticky Note refund",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -50,
        -50
      ],
      "parameters": {
        "content": "## create_refund fuehrt bewusst KEINE Erstattung aus\nDas Tool legt eine Erstattungs-Anfrage zur menschlichen Freigabe an, statt Geld zu bewegen. Ein Sprachmodell, das eine Bestellnummer und einen Betrag halluziniert, wuerde sonst echtes Geld auszahlen -- und der Schaden ist nicht rueckholbar.\n\nDie Sperre ist die Zeile in approvals, nicht das Ticket: ein Ticket ist eine Notiz, die jemand uebersehen kann, eine Freigabe bleibt offen, bis ein Admin entscheidet. Sie erscheint im Governance-Screen.\n\nDer Rueckgabewert sagt dem Agenten ausdruecklich, dass nichts ausgefuehrt wurde.",
        "color": 3,
        "width": 740,
        "height": 340
      }
    },
    {
      "name": "File Approval Request",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "notes": "Die eigentliche Sperre: der Vorgang wartet als Zeile in approvals auf eine menschliche Entscheidung. Das Ticket allein waere nur eine Notiz, die jemand uebersehen kann.",
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "approvals",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "organization_id",
              "fieldValue": "={{ $('Refund Requested').item.json.organization_id }}"
            },
            {
              "fieldId": "conversation_id",
              "fieldValue": "={{ $('Refund Requested').item.json.conversation_id }}"
            },
            {
              "fieldId": "agent_id",
              "fieldValue": "={{ $('Refund Requested').item.json.agent_id }}"
            },
            {
              "fieldId": "ticket_id",
              "fieldValue": "={{ $('File Refund Request').item.json.id }}"
            },
            {
              "fieldId": "tool_name",
              "fieldValue": "create_refund"
            },
            {
              "fieldId": "summary",
              "fieldValue": "=Rueckerstattung {{ $('Refund Requested').item.json.amount }} {{ $('Refund Requested').item.json.currency }} fuer {{ $('Refund Requested').item.json.order_reference }}"
            },
            {
              "fieldId": "amount",
              "fieldValue": "={{ $('Refund Requested').item.json.amount }}"
            },
            {
              "fieldId": "currency",
              "fieldValue": "={{ $('Refund Requested').item.json.currency }}"
