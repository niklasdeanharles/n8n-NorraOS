    {
      "name": "Classify Turn",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        1140,
        0
      ],
      "onError": "continueRegularOutput",
      "notes": "Laeuft NACH der gestreamten Antwort, kostet den Kunden also keine Wartezeit. Speist Topic Explorer und Gap Detection -- ohne diesen Schritt bleiben beide Auswertungen dauerhaft leer.",
      "parameters": {
        "text": "={{ 'Kundenfrage: ' + $('Normalize Request').item.json.message + '\\n\\nAntwort des Agenten: ' + $('Support Agent').item.json.output }}",
        "schemaType": "fromAttributes",
        "attributes": {
          "attributes": [
            {
              "name": "topic",
              "type": "string",
              "required": true,
              "description": "Das Hauptthema in zwei bis drei Woertern, konsistent benannt, z.B. Versand, Retouren, Groessenberatung, Zahlung, Reklamation. Kein ganzer Satz."
            },
            {
              "name": "knowledge_gap",
              "type": "boolean",
              "required": true,
              "description": "true, wenn die Antwort die Frage NICHT inhaltlich beantwortet hat, weil die noetige Information fehlte -- etwa wenn der Agent auf einen Menschen verwiesen oder eingeraeumt hat, es nicht zu wissen. false, wenn die Frage beantwortet wurde."
            },
            {
              "name": "title",
              "type": "string",
              "required": true,
              "description": "Kurze Betreffzeile der Konversation aus Kundensicht, maximal 60 Zeichen, ohne Anfuehrungszeichen."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "Du klassifizierst einen abgeschlossenen Support-Turn fuer die Auswertung. Benenne Themen konsistent und knapp, damit sich gleiche Anliegen ueber viele Konversationen hinweg zusammenfassen lassen."
        }
      }
    },
